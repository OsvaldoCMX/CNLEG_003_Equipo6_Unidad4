  "components": {
    "schemas": {
      "AddItemRequest": {
        "properties": {
          "sku": {
            "type": "string",
            "title": "Sku",
            "description": "SKU de productos.csv",
            "examples": [
              "SKU001"
            ]
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity",
            "description": "Unidades a agregar (el dominio exige > 0)",
            "examples": [
              2
            ]
          }
        },
        "type": "object",
        "required": [
          "sku",
          "quantity"
        ],
        "title": "AddItemRequest"
      },
      "CancelRequest": {
        "properties": {
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason",
            "description": "Motivo de cancelación (obligatorio para el dominio)"
          }
        },
        "type": "object",
        "title": "CancelRequest",
        "examples": [
          {
            "reason": "El cliente cambió de opinión"
          }
        ]
      },
      "CreateOrderRequest": {
        "properties": {
          "customer_id": {
            "type": "string",
            "title": "Customer Id",
            "description": "Id del cliente en clientes.csv",
            "examples": [
              "C001"
            ]
          },
          "has_promotion": {
            "type": "boolean",
            "title": "Has Promotion",
            "description": "¿El pedido tiene una promoción activa?",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "customer_id"
        ],
        "title": "CreateOrderRequest"
      },
      "DiscountDTO": {
        "properties": {
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "percentage": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Percentage",
            "examples": [
              "10"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Explicación para el cliente"
          },
          "rule": {
            "type": "string",
            "title": "Rule",
            "description": "Regla técnica (Specification) que se aplicó"
          },
          "total_before": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Total Before"
          },
          "discount": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Discount"
          },
          "total_after": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Total After"
          },
          "checks": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Checks",
            "description": "Condiciones evaluadas: ✔ se cumple / ✘ no se cumple"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "percentage",
          "message",
          "rule",
          "total_before",
          "discount",
          "total_after",
          "checks"
        ],
        "title": "DiscountDTO"
      },
      "ErrorDTO": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error",
            "description": "Código del error (para programas)",
            "examples": [
              "InvalidOrderTransition"
            ]
          },
          "mensaje": {
            "type": "string",
            "title": "Mensaje",
            "description": "Mensaje para el cliente, en lenguaje sencillo",
            "examples": [
              "El pedido O001 ya fue confirmado; no es necesario confirmarlo otra vez."
            ]
          }
        },
        "type": "object",
        "required": [
          "error",
          "mensaje"
        ],
        "title": "ErrorDTO"
      },
      "EventDTO": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Nombre técnico del Domain Event",
            "examples": [
              "OrderConfirmed"
            ]
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Qué pasó, en lenguaje sencillo",
            "examples": [
              "Pedido confirmado"
            ]
          },
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data",
            "description": "Datos propios del evento"
          }
        },
        "type": "object",
        "required": [
          "name",
          "description",
          "order_id",
          "occurred_at"
        ],
        "title": "EventDTO"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OrderDTO": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "examples": [
              "O001"
            ]
          },
          "customer_id": {
            "type": "string",
            "title": "Customer Id"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Código interno del estado (para programas)",
            "examples": [
              "DRAFT"
            ]
          },
          "status_label": {
            "type": "string",
            "title": "Status Label",
            "description": "Estado para mostrar al cliente",
            "examples": [
              "Pendiente de confirmar"
            ]
          },
          "units": {
            "type": "integer",
            "title": "Units"
          },
          "total": {
            "type": "string",
